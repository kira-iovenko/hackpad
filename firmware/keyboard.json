{
    "keyboard_name": "Kira Hackpad",
    "manufacturer": "Kira Iovenko",
    "maintainer": "Kira Iovenko",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "nkro": true,
        "encoder": true
    },
    "usb": {
        "vid": "0x4B49",
        "pid": "0x4850",
        "device_version": "1.0.0"
    },
    "matrix_pins": {
        "rows": ["GP0", "GP1", "GP2"],
        "cols": ["GP26", "GP27", "GP28", "GP29"]
    },
    "diode_direction": "COL2ROW",
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0,0], "x": 0, "y": 0},
                {"matrix": [0,1], "x": 1, "y": 0},
                {"matrix": [0,2], "x": 2, "y": 0},
                {"matrix": [0,3], "x": 3, "y": 0},

                {"matrix": [1,0], "x": 0, "y": 1},
                {"matrix": [1,1], "x": 1, "y": 1},
                {"matrix": [1,2], "x": 2, "y": 1},
                {"matrix": [1,3], "x": 3, "y": 1},

                {"matrix": [2,0], "x": 0, "y": 2},
                {"matrix": [2,1], "x": 1, "y": 2},
                {"matrix": [2,2], "x": 2, "y": 2},
                {"matrix": [2,3], "x": 3, "y": 2}
            ]
        }
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP3", "pin_b": "GP4", "resolution": 4}
        ]
    }
}